# cargo-deny configuration for security auditing and dependency management
# Documentation: https://embarkstudios.github.io/cargo-deny/

# General configuration
[graph]
targets = []
all-features = true
no-default-features = false

# Security Advisory Database Checking
[advisories]
version = 2
db-path = "~/.cargo/advisory-db"
db-urls = ["https://github.com/rustsec/advisory-db"]

# How to handle security vulnerabilities
vulnerability = "deny"
unmaintained = "warn"
yanked = "deny"
notice = "warn"
unsound = "deny"

# Ignore specific advisories (add CVE IDs here if needed)
ignore = [
    # Example: "RUSTSEC-2020-0001",
]

# License Configuration
[licenses]
version = 2

# Ensure project is compatible with these licenses
allow = [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 WITH LLVM-exception",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Unicode-DFS-2016",
    "Unlicense",
    "Zlib",
]

# Deny these licenses
deny = [
    "GPL-3.0",
    "AGPL-3.0",
    "LGPL-3.0",
]

# License exceptions for specific crates
exceptions = []

# Copyleft licenses that require special handling
copyleft = "deny"

# Allow OSI and FSF approved licenses
allow-osi-fsf-free = "both"

# Default license confidence threshold
confidence-threshold = 0.8

# Sources Configuration
[sources]
unknown-registry = "deny"
unknown-git = "deny"

# Allow crates from crates.io
allow-registry = ["https://github.com/rust-lang/crates.io-index"]

# Allow git sources from specific organizations only
allow-git = []

# Banned Crates
[bans]
multiple-versions = "warn"
wildcards = "deny"
highlight = "all"

# Allow multiple versions of these crates (if needed)
skip = []

# Skip checking for these dependency trees
skip-tree = []

# Denied crates - security or quality issues
deny = [
    # Example: { name = "unsafe-crate", version = "*" },
]

# Workspace dependency validation
workspace-dependencies = true

# External default features must be specified
external-default-features = "allow"

# Feature configuration
allow-wildcard-paths = false
